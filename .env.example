# Frontend environment — copy to .env in the project root (required for npm run dev)

# Production API (Railway) — used when testing against deployed backend
# VITE_API_URL=https://larte-del-dolce-erp-production.up.railway.app/api

# Local development (start Laravel with: cd larte-backend && php artisan serve)
VITE_API_URL=http://127.0.0.1:8000/api

# Jitsi Meet domain (embedded video meetings)
VITE_JITSI_DOMAIN=meet.jit.si
